# ============================================================
# .htaccess — Gray Tile & Remodeling
# ============================================================

Options -Indexes
DirectoryIndex index.php index.html

# ------------------------------------------------------------
# Security Headers
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ------------------------------------------------------------
# Gzip Compression
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ------------------------------------------------------------
# Browser Caching
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ------------------------------------------------------------
# Clean URLs
# - Real directories with index.php served via DirectoryIndex
# - Real files served as-is
# - Otherwise, append .php to extensionless URLs
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

# Dynamic sitemap (v6.3) — never a static sitemap.xml
RewriteRule ^sitemap\.xml$ /sitemap.php [L]
RewriteRule ^sitemap-images\.xml$ /sitemap.php [L]

# Canonical host: force HTTPS + non-www
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Skip rewrite for assets and includes
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/includes/

    # Skip if it's a real file or real directory
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Try .php extension
    RewriteRule ^([^\.]+)$ $1.php [NC,L]

    # Redirect .php requests to clean URLs (301)
    RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
    RewriteRule ^ /%1 [NC,L,R=301]
</IfModule>

# ------------------------------------------------------------
# Custom 404
# ------------------------------------------------------------
ErrorDocument 404 /404.php

# v6.3 retrofit (2026-09-04): brotli first, immutable static assets (css/js carry ?v=), revalidating HTML
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml application/ld+json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|woff|webp|avif|jpe?g|png|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType font/woff2 .woff2
</IfModule>
